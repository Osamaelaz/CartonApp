<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cartonapp</groupId>
    <artifactId>carton-accounting</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Carton Accounting</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <app.main.class>com.cartonapp.Main</app.main.class>
        <!-- exe = installer (needs WiX). app-image = folder with a ready exe, no WiX needed -->
        <jpackage.type>exe</jpackage.type>
    </properties>

    <dependencies>
        <!-- PostgreSQL JDBC driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.7</version>
        </dependency>

        <!-- Modern Swing look and feel -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.6</version>
        </dependency>

        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-extras</artifactId>
            <version>3.6</version>
        </dependency>

        <dependency>
            <groupId>com.miglayout</groupId>
            <artifactId>miglayout-swing</artifactId>
            <version>11.4.2</version>
        </dependency>

        <!-- Local customer export and account-statement PDF generation -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>

        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>

            <!-- Step 1: copy all libraries next to the app jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-libs</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/input</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Step 2: build the app jar inside target/input -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <outputDirectory>${project.build.directory}/input</outputDirectory>
                    <archive>
                        <manifest>
                            <mainClass>${app.main.class}</mainClass>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Step 3: run jpackage, the result is in target/dist -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>make-exe</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/jpackage</executable>
                            <arguments>
                                <argument>--type</argument>
                                <argument>${jpackage.type}</argument>
                                <argument>--name</argument>
                                <argument>${project.name}</argument>
                                <argument>--app-version</argument>
                                <argument>${project.version}</argument>
                                <argument>--input</argument>
                                <argument>${project.build.directory}/input</argument>
                                <argument>--main-jar</argument>
                                <argument>${project.artifactId}.jar</argument>
                                <argument>--main-class</argument>
                                <argument>${app.main.class}</argument>
                                <argument>--dest</argument>
                                <argument>${project.build.directory}/dist</argument>
                                <argument>--icon</argument>
                                <argument>${project.basedir}/packaging/app-icon.ico</argument>
                                <argument>--vendor</argument>
                                <argument>Leithi Pack</argument>
                                <argument>--description</argument>
                                <argument>Leithi Pack - Corrugated Carton Accounting</argument>
                                <argument>--copyright</argument>
                                <argument>Leithi Pack</argument>
                                <!-- Fixed id: a newer installer replaces the old version instead of installing beside it. -->
                                <argument>--win-upgrade-uuid</argument>
                                <argument>6a1665e1-cdef-41c1-a329-76501c428527</argument>
                                <!-- Modules bundled with the app (jdeps result plus safe extras). -->
                                <argument>--add-modules</argument>
                                <argument>java.base,java.desktop,java.prefs,java.security.jgss,java.security.sasl,java.sql,java.xml,java.xml.crypto,java.naming,java.logging,java.management,jdk.unsupported</argument>
                                <argument>--java-options</argument>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <argument>--win-menu</argument>
                                <argument>--win-shortcut</argument>
                                <argument>--win-dir-chooser</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
